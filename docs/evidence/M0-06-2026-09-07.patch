+    engine = get_engine().sync_engine
+
+    def enable(connection, _record):
+        cursor = connection.cursor()
+        cursor.execute("PRAGMA foreign_keys=ON")
+        cursor.close()
+
+    event.listen(engine, "connect", enable)
+    yield
+    event.remove(engine, "connect", enable)
+
